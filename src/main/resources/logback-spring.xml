<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- P2 Observability: единый формат логов с трассировкой traceId/userId из MDC.
         traceId  — MdcLoggingFilter (X-Request-Id или UUID на запрос).
         userId   — JwtAuthenticationFilter / MdcLoggingFilter (sub из JWT). -->

    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [traceId=%X{traceId:-} userId=%X{userId:-}] [%thread] %logger{36} - %msg%n"/>

    <springProperty scope="context" name="LOG_LEVEL_ROOT" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="LOG_LEVEL_APP" source="logging.level.com.kov.techuserservice" defaultValue="INFO"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.kov.techuserservice" level="${LOG_LEVEL_APP}"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

    <springProfile name="!prod">
        <root level="${LOG_LEVEL_ROOT}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <!-- В prod тот же console-формат: сбор через stdout коллектором (ELK/Loki). -->
        <root level="${LOG_LEVEL_ROOT}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
