# Локальные значения для `docker compose up` (не коммитить секреты — см. .env.example).
DB_NAME=mydatabase
DB_USERNAME=myuser
DB_PASSWORD=secret
POSTGRES_PORT=5432

SERVER_PORT=8001
DB_URL=jdbc:postgresql://postgres:5432/mydatabase

JWT_SECRET=5A7C3F9D2E6B8A1C4F7D0E3B9A2C5F8D1E4B7A0C3F6D9B2E5A8C1F4D7B0E3A6
JWT_ACCESS_MS=900000
JWT_REFRESH_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000
ACTUATOR_EXPOSURE=health,info,prometheus
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
