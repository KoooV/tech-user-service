# Переменные окружения tech-user-service (локальная разработка).
# Скопируйте в `.env` и поправьте секреты:  cp .env.example .env
# В production значения подставляются из секретов оркестратора, а не из файла.

# --- Postgres ---
DB_NAME=mydatabase
DB_USERNAME=myuser
DB_PASSWORD=change-me-in-prod
POSTGRES_PORT=5432

# --- Приложение ---
SERVER_PORT=8001
# В compose приложение ходит в БД по имени сервиса `postgres`;
# для локального запуска вне compose переопределите на localhost.
DB_URL=jdbc:postgresql://postgres:5432/mydatabase
DB_URL_LOCAL=jdbc:postgresql://localhost:5432/mydatabase

# --- JWT (dev only! в prod — длинный случайный секрет из vault) ---
JWT_SECRET=5A7C3F9D2E6B8A1C4F7D0E3B9A2C5F8D1E4B7A0C3F6D9B2E5A8C1F4D7B0E3A6
JWT_ACCESS_MS=900000
JWT_REFRESH_MS=86400000

# --- CORS (через запятую) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Actuator ---
ACTUATOR_EXPOSURE=health,info,metrics,prometheus

# --- Логи ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
